NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend and CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# SMTP / Nodemailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM=your_email@gmail.com

# Initial admin seeding
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Cookie settings, if cookie-based authentication is implemented
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---- Optional application settings (sensible defaults are used if omitted) ----
# Minutes your local time is ahead of UTC. Used to interpret slot dates/times
# (e.g. 330 for India Standard Time, 0 for UTC, -300 for US Eastern standard time).
TIMEZONE_OFFSET_MINUTES=330
# Students can cancel an APPROVED appointment only if it starts at least this many hours away.
CANCELLATION_MIN_HOURS=2
# Max login/registration attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
# Set to true when running behind a reverse proxy (Render, Heroku, Nginx...)
TRUST_PROXY=false
